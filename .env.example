# Blaque Baux — Environment Variables
# Copy this file to .env and fill in your values

# Polygon.io API key
# Get one at https://polygon.io
# Free tier: 5 calls/min (enough for testing with --quick flag)
# Starter tier $29/mo: unlimited calls (recommended for full 2yr backtest)
POLYGON_API_KEY=your_polygon_api_key_here
