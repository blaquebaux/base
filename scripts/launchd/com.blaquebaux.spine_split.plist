<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Autonomous daily job for the SPLIT-UNIVERSE spine on a SECOND, isolated Alpaca paper account
     (live A/B vs the single-universe spine). Runs Mon-Fri 09:21 local (1 min after the single job,
     purely to stagger). The wrapper skips cleanly until ~/.config/blaquebaux/alpaca_split.env exists,
     so this can be installed before the 2nd account is created. PAPER only. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.blaquebaux.spine_split</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/malcolmx/blaquebaux/scripts/run_spine_split_daily.sh</string>
    </array>

    <!-- Pre-open 09:21 plus morning catch-up fires (10:31, 11:46, 13:01), staggered 1 min after the
         single job. Time-only; the wrapper's trading-day gate + catch-up guard make all but the first
         placement a no-op, so a slept/absent Mac still trades exactly once when next awake. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>21</integer></dict>
        <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>31</integer></dict>
        <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>46</integer></dict>
        <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>1</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/malcolmx/blaquebaux/logs/launchd_split.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/malcolmx/blaquebaux/logs/launchd_split.err</string>
</dict>
</plist>
