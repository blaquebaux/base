<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Autonomous daily spine trade job. Runs Mon-Fri at 09:20 local (= 09:20 ET on this Mac),
     pre-open, so daily bars are complete and orders fill at the open. Install: see the header
     of scripts/run_spine_daily.sh and the setup steps Claude provided. PAPER only until the
     live safety gate (loss-halt + alerting) is armed. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.blaquebaux.spine</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/malcolmx/Downloads/Blaque Baux and Crypto Quant/blaque_baux_canonical/scripts/run_spine_daily.sh</string>
    </array>

    <!-- Mon(1) .. Fri(5) at 09:20 local. The wrapper still gates on the Alpaca calendar for holidays. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>20</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>20</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>20</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>20</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>20</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <!-- launchd starts with a bare PATH; give curl/bash a sane one (Julia is called by absolute path). -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/malcolmx/Downloads/Blaque Baux and Crypto Quant/blaque_baux_canonical/logs/launchd.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/malcolmx/Downloads/Blaque Baux and Crypto Quant/blaque_baux_canonical/logs/launchd.err</string>
</dict>
</plist>
