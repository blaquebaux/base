<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Autonomous daily spine trade job. Runs Mon-Fri at 09:20 local (= 09:20 ET on this Mac),
     pre-open, so daily bars are complete and orders fill at the open. Install: see the header
     of scripts/run_spine_daily.sh and the setup steps Claude provided. PAPER only until the
     live safety gate (loss-halt + alerting) is armed. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.blaquebaux.spine</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/malcolmx/blaquebaux/scripts/run_spine_daily.sh</string>
    </array>

    <!-- Pre-open 09:20 plus morning catch-up fires (10:30, 11:45, 13:00). Time-only so it also fires
         on weekends/holidays, which the wrapper's trading-day gate skips cleanly; the catch-up guard
         makes every fire after the first placement a no-op. This survives a slept/absent Mac: the book
         is placed the first time the Mac is awake during the window, exactly once. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>20</integer></dict>
        <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <!-- launchd starts with a bare PATH; give curl/bash a sane one (Julia is called by absolute path). -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/malcolmx/blaquebaux/logs/launchd.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/malcolmx/blaquebaux/logs/launchd.err</string>
</dict>
</plist>
