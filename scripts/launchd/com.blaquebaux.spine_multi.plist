<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- THIRD paper account: single 6-asset universe + multi-horizon trend (the clean single-multi A/B leg
     vs account #1's single-sign). Pre-open 09:22 + morning catch-ups (10:32/11:47/13:02), time-only so
     the wrapper's trading-day gate handles weekends and the catch-up guard makes all but the first
     placement a no-op. Skips until ~/.config/blaquebaux/alpaca_multi.env exists. PAPER only. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.blaquebaux.spine_multi</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/malcolmx/blaquebaux/scripts/run_spine_multi_daily.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>22</integer></dict>
        <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>32</integer></dict>
        <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>47</integer></dict>
        <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>2</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/malcolmx/blaquebaux/logs/launchd_multi.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/malcolmx/blaquebaux/logs/launchd_multi.err</string>
</dict>
</plist>
